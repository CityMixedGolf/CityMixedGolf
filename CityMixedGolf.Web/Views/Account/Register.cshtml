@model CityMixedGolf.Web.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create account";
}

<div class="hero-band">
    <div class="container">
        <h1>Create account</h1>
        <p>City of Newcastle GC &ndash; Mixed Golf Section</p>
    </div>
</div>

<div class="container mt-4" style="max-width:480px">
    <div class="golf-panel">
        <div class="golf-panel-header">
            <h2 class="golf-panel-title"><i class="ti ti-user-plus"></i> New member registration</h2>
        </div>
        <div class="p-4">
            <form method="post" asp-controller="Account" asp-action="Register">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert-golf-warning mb-3" style="display:@(ViewContext.ModelState.IsValid ? "none" : "block")"></div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label asp-for="FirstName" class="form-label" style="font-size:0.8rem;font-weight:500;color:var(--golf-muted);text-transform:uppercase;letter-spacing:0.04em"></label>
                        <input asp-for="FirstName" class="form-control" style="border-color:#ccc;font-size:0.9rem" placeholder="Sarah" />
                        <span asp-validation-for="FirstName" class="text-danger" style="font-size:0.75rem"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="LastName" class="form-label" style="font-size:0.8rem;font-weight:500;color:var(--golf-muted);text-transform:uppercase;letter-spacing:0.04em"></label>
                        <input asp-for="LastName" class="form-control" style="border-color:#ccc;font-size:0.9rem" placeholder="Mitchell" />
                        <span asp-validation-for="LastName" class="text-danger" style="font-size:0.75rem"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label" style="font-size:0.8rem;font-weight:500;color:var(--golf-muted);text-transform:uppercase;letter-spacing:0.04em"></label>
                    <input asp-for="Email" class="form-control" style="border-color:#ccc;font-size:0.9rem" placeholder="your@email.com" />
                    <span asp-validation-for="Email" class="text-danger" style="font-size:0.75rem"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label asp-for="Gender" class="form-label" style="font-size:0.8rem;font-weight:500;color:var(--golf-muted);text-transform:uppercase;letter-spacing:0.04em"></label>
                        <select asp-for="Gender" asp-items="Html.GetEnumSelectList<CityMixedGolf.Web.Models.Gender>()"
                                class="form-select" style="border-color:#ccc;font-size:0.9rem">
                            <option value="">Select...</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger" style="font-size:0.75rem"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="HandicapIndex" class="form-label" style="font-size:0.8rem;font-weight:500;color:var(--golf-muted);text-transform:uppercase;letter-spacing:0.04em"></label>
                        <input asp-for="HandicapIndex" class="form-control" style="border-color:#ccc;font-size:0.9rem" placeholder="e.g. 14.2" step="0.1" />
                        <span asp-validation-for="HandicapIndex" class="text-danger" style="font-size:0.75rem"></span>
                        <div style="font-size:0.7rem;color:var(--golf-muted);margin-top:3px">18.0 or under = Green band</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label" style="font-size:0.8rem;font-weight:500;color:var(--golf-muted);text-transform:uppercase;letter-spacing:0.04em"></label>
                    <input asp-for="Password" class="form-control" style="border-color:#ccc;font-size:0.9rem" placeholder="At least 8 characters" />
                    <span asp-validation-for="Password" class="text-danger" style="font-size:0.75rem"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label" style="font-size:0.8rem;font-weight:500;color:var(--golf-muted);text-transform:uppercase;letter-spacing:0.04em"></label>
                    <input asp-for="ConfirmPassword" class="form-control" style="border-color:#ccc;font-size:0.9rem" placeholder="Repeat password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:0.75rem"></span>
                </div>

                <button type="submit" class="btn btn-golf-primary w-100">Create account</button>
            </form>

            <hr style="border-color:#ede8e0;margin:1.5rem 0" />

            <p style="font-size:0.875rem;color:var(--golf-muted);text-align:center;margin:0">
                Already have an account?
                <a asp-controller="Account" asp-action="Login" style="color:var(--golf-green);font-weight:500">Sign in</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
