<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – City of Newcastle GC Mixed</title>

    <!-- Bootstrap 5 via CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Tabler Icons via CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@2.44.0/tabler-icons.min.css" />

    <!-- Golf theme -->
    <link rel="stylesheet" href="~/css/golf-theme.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-golf">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-area="Public" asp-controller="Home" asp-action="Index">
                <span style="width:32px;height:32px;border-radius:50%;background:var(--golf-gold);display:flex;align-items:center;justify-content:center;">
                    <i class="ti ti-golf" style="color:var(--golf-green);font-size:16px;"></i>
                </span>
                <span>
                    City of Newcastle GC
                    <small class="d-block" style="font-size:0.65rem;color:rgba(255,255,255,0.5);letter-spacing:0.05em;text-transform:uppercase;">Mixed Golf Section</small>
                </span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto align-items-center gap-1">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Public" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Member" asp-controller="Entry" asp-action="Index">My Dashboard</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Admin" asp-controller="Competition" asp-action="Index">Admin</a>
                            </li>
                        }
                        <li class="nav-item">
                            <form method="post" asp-area="" asp-controller="Account" asp-action="Logout">
                                <button type="submit" class="btn btn-golf-outline btn-sm">Sign out</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-golf-gold btn-sm" asp-area="" asp-controller="Account" asp-action="Login">Sign in</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @if (TempData["Success"] != null)
        {
            <div class="container mt-3">
                <div class="alert-golf-success">
                    <i class="ti ti-circle-check me-1"></i> @TempData["Success"]
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="mt-5 py-3 text-center" style="background:var(--golf-green);color:rgba(255,255,255,0.4);font-size:0.75rem;">
        &copy; @DateTime.Now.Year City of Newcastle Golf Club &ndash; Mixed Section
    </footer>

    <!-- Bootstrap 5 JS via CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>