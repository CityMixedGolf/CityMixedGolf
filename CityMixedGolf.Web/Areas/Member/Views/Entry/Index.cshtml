@{
    ViewData["Title"] = "My Dashboard";
    var player = (GolfPlayer)ViewBag.Player;
    var entries = (List<CompetitionEntry>)ViewBag.Entries;
    var open = (List<Competition>)ViewBag.OpenCompetitions;
    var history = (List<DrawPair>)ViewBag.History;
}

<div class="hero-band">
    <div class="container">
        <h1>My Dashboard</h1>
        <p>Welcome back, @player.FirstName</p>
    </div>
</div>

<div class="container mt-4">
    <div class="row g-4">

        <!-- Sidebar -->
        <div class="col-md-3">
            <div class="golf-panel mb-3">
                <div class="p-3 text-center">
                    <div style="width:52px;height:52px;border-radius:50%;background:var(--golf-green);display:flex;align-items:center;justify-content:center;font-size:1.25rem;font-weight:500;color:var(--golf-gold);margin:0 auto 0.75rem">
                        @player.FirstName[0]@player.LastName[0]
                    </div>
                    <div class="fw-500">@player.FullName</div>
                    <div style="font-size:0.8rem;color:var(--golf-muted)">Handicap: @player.HandicapIndex.ToString("F1")</div>
                    <span class="badge-@(player.BandColour.ToString().ToLower())-band mt-2 d-inline-block">@player.BandColour band</span>
                </div>
            </div>

            <div class="golf-panel">
                <div class="golf-panel-header"><h2 class="golf-panel-title"><i class="ti ti-bell"></i> Notifications</h2></div>
                <div class="p-3">
                    <p style="font-size:0.8rem;color:var(--golf-muted);margin-bottom:0.75rem">Choose how you receive draw results and reminders.</p>
                    <form method="post" asp-area="Member" asp-controller="Entry" asp-action="UpdateNotifications">
                        @Html.AntiForgeryToken()
                        <div class="d-flex align-items-start gap-2 mb-2">
                            <input type="checkbox" id="chk-email" name="emailNotifications" class="mt-1" style="accent-color:var(--golf-green)" @(player.EmailNotifications ? "checked" : "") />
                            <label for="chk-email">
                                <span style="font-size:0.875rem">Email</span>
                                <span style="font-size:0.75rem;color:var(--golf-muted);display:block">@player.Email</span>
                            </label>
                        </div>
                        <div class="d-flex align-items-start gap-2 mb-3">
                            <input type="checkbox" id="chk-wa" name="whatsAppOptIn" class="mt-1" style="accent-color:var(--golf-green)" @(player.WhatsAppOptIn ? "checked" : "") />
                            <label for="chk-wa">
                                <span style="font-size:0.875rem">WhatsApp</span>
                                <span style="font-size:0.75rem;color:var(--golf-muted);display:block">@(string.IsNullOrEmpty(player.MobileNumber) ? "Add a mobile number to enable" : player.MobileNumber)</span>
                            </label>
                        </div>
                        <button type="submit" class="btn btn-golf-outline btn-sm w-100">Save preferences</button>
                    </form>
                    <p style="font-size:0.7rem;color:var(--golf-muted);margin-top:0.5rem"><i class="ti ti-info-circle"></i> Update your mobile number under profile settings.</p>
                </div>
            </div>
        </div>

        <!-- Main content -->
        <div class="col-md-9">

            <!-- Open entries -->
            @foreach (var entry in entries.Where(e => e.Status == EntryStatus.Entered && e.Competition.EntryCloseDate >= DateTime.UtcNow))
            {
                <div class="golf-panel mb-3">
                    <div class="golf-panel-header d-flex justify-content-between align-items-start">
                        <div>
                            <h2 class="golf-panel-title mb-0">@entry.Competition.Name</h2>
                            <small style="color:rgba(255,255,255,0.6);font-size:0.75rem">@entry.Competition.CompetitionDate.ToString("dddd dd MMMM yyyy") &middot; @entry.Competition.Format</small>
                        </div>
                        <span class="badge badge-open px-2 py-1 rounded-pill">Entry open</span>
                    </div>
                    <div class="p-3">
                        <div class="alert-golf-success mb-3">
                            <i class="ti ti-circle-check me-1"></i> You are entered &middot; Entry closes @entry.Competition.EntryCloseDate.ToString("dddd dd MMMM")
                        </div>
                        <a asp-area="Member" asp-controller="Entry" asp-action="Enter" asp-route-competitionId="@entry.CompetitionId" class="btn btn-golf-outline btn-sm me-2">Amend entry</a>
                        <form method="post" asp-area="Member" asp-controller="Entry" asp-action="Cancel" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="entryId" value="@entry.Id" />
                            <button type="submit" class="btn btn-sm" style="color:#c0392b;border:1px solid #e0b0ad;background:#fff" onclick="return confirm(Cancel your entry for @entry.Competition.Name?)">Cancel entry</button>
                        </form>
                    </div>
                </div>
            }

            <!-- Open competitions not yet entered -->
            @foreach (var comp in open.Where(c => entries.All(e => e.CompetitionId != c.Id || e.Status == EntryStatus.Cancelled)))
            {
                <div class="golf-panel mb-3">
                    <div class="golf-panel-header">
                        <h2 class="golf-panel-title">@comp.Name</h2>
                        <span class="badge badge-open px-2 py-1 rounded-pill" style="font-size:0.7rem">Entry open</span>
                    </div>
                    <div class="p-3 d-flex align-items-center justify-content-between">
                        <div style="font-size:0.875rem;color:var(--golf-muted)">@comp.CompetitionDate.ToString("dd MMMM yyyy") &middot; Entry closes @comp.EntryCloseDate.ToString("dd MMMM")</div>
                        <a asp-area="Member" asp-controller="Entry" asp-action="Enter" asp-route-competitionId="@comp.Id" class="btn btn-golf-primary btn-sm">Enter now</a>
                    </div>
                </div>
            }

            <!-- History -->
            <div class="golf-panel">
                <div class="golf-panel-header"><h2 class="golf-panel-title"><i class="ti ti-history"></i> My competition history</h2></div>
                <table class="golf-table">
                    <thead><tr><th>Date</th><th>Competition</th><th>Played with</th><th class="text-end">Score / Pos</th></tr></thead>
                    <tbody>
                    @if (history.Any())
                    {
                        @foreach (var pair in history)
                        {
                            var partner = pair.GreenBandPlayerId == player.Id ? pair.RedBandPlayer : pair.GreenBandPlayer;
                            <tr>
                                <td style="color:var(--golf-muted)">@pair.GroupDraw.Competition.CompetitionDate.ToString("dd MMM yyyy")</td>
                                <td class="fw-500">@pair.GroupDraw.Competition.Name</td>
                                <td style="color:var(--golf-muted)">@partner.FullName</td>
                                <td class="text-end">
                                    <div class="fw-500" style="color:var(--golf-green)">@pair.Score pts</div>
                                    <div style="font-size:0.7rem;color:var(--golf-muted)">@(pair.Position.HasValue ? $"{pair.Position}{(pair.Position == 1 ? "st" : pair.Position == 2 ? "nd" : pair.Position == 3 ? "rd" : "th")} overall" : "")</div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="text-center py-3" style="color:var(--golf-muted)">No competition history yet</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>